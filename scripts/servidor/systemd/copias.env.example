# /etc/crm-copias/copias.env (root:root 600) - configuración de la copia diaria (#634).
# Ejemplo del 360. En ISEIE: COPIAS_BASES="crm_iseie crm_iseie_staging", sin Docker ni SQLite,
# y COPIAS_DIR=/var/backups/crm-iseie/base.
COPIAS_BASES="crm_prod_db crm_test_db"
COPIAS_DOCKER_PG="contenedor:base"
COPIAS_SQLITE="app=/ruta/a/la.db"
COPIAS_DIR=/var/backups/crm/base
COPIAS_DIARIAS=7
COPIAS_SEMANALES=4
COPIAS_MIN_LIBRE_MB=2048
# Fuera del VPS (rclone configurado como root). Vacío = solo en este disco.
COPIAS_REMOTO=
