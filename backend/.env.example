# Database
DATABASE_URL=postgresql://crm_user:password@localhost:5432/crm_db

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Encryption (AES-256-GCM para API keys)
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Cambiar el propio correo con un código (#211): el código se guarda como HMAC
# con esta clave, no como un sha256 sin secreto (seis cifras se sacan por fuerza
# bruta en un momento). Generala con `openssl rand -hex 32`. Si falta, se usa
# JWT_SECRET; si tampoco hay, el servidor no arranca el cambio de correo.
# CODIGO_CORREO_SECRET=

# El freno de correos a tutores (Diego, 15/09). SIN la variable, el freno sigue
# puesto: a los tutores no les sale ningún correo del CRM (ni el código para
# cambiar su correo). Para levantarlo: CORREOS_A_TUTORES=1 y reiniciar. Antes,
# arreglar el enlace de contraseña de Brevo. Ver shared/config/frenoTutores.js.
# CORREOS_A_TUTORES=1

# Cursos pendientes (#336, #770). Los correos van apagados de serie: con
# CURSOS_PENDIENTES_CORREOS_ACTIVOS=true salen detras de la campana (y a tutores,
# solo si ademas se levanta el freno de arriba). Al vender un curso marcado
# «sin desarrollar», la fecha limite es la venta + estos dias (si el producto no
# trae los suyos): un numero para todos o por tipo. De serie, 30/45/60.
# CURSOS_PENDIENTES_CORREOS_ACTIVOS=false
# CURSOS_PENDIENTES_PLAZO_DIAS=curso=30,diplomado=45,master=60

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-access-key
CLOUDFLARE_R2_SECRET_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET=crm-dossiers

# Brevo (email)
BREVO_API_KEY=your-brevo-api-key

# A DONDE APUNTAN LOS ENLACES QUE EL CRM MANDA POR CORREO.
#
# Vacio = `http://localhost:5173/crm`, que es el equipo de quien desarrolla. En
# un servidor eso convierte TODOS los enlaces salientes en enlaces muertos, y no
# da ningun error: el correo sale bien, se entrega bien, y quien lo abre acaba
# en una pagina que no carga. Lo unico que se ve es que «no funciona el enlace».
#
# No es un correo, son SIETE, y uno de ellos es la unica forma de volver a
# entrar si pierdes la contrasena:
#
#   recuperar la contrasena (#37)     el enlace de «la he olvidado»
#   alta de usuario                   el enlace para poner la primera clave
#   recordatorios                     el aviso de seguimiento vencido
#   resumen del dia                   el correo de cada gestora por la manana
#   avisos de leads                   el lead nuevo que le toca a alguien
#   plantillas de correo              lo que lleve un enlace al CRM
#   aviso al tutor                    su ficha de comisiones
#
# SIN LA BARRA FINAL. El codigo pega `/set-password?token=...` detras, y con la
# barra puesta sale una doble que unos servidores perdonan y otros no.
#
# El correo de feedback («¿por qué has desistido?») usa FEEDBACK_BASE_URL si
# está y, si no, esta. En producción (NODE_ENV=production) sin ninguna de las
# dos la API NO ARRANCA (#1154): es mejor verlo en PM2 que mandar encuestas
# con un enlace a localhost.
CRM_BASE_URL=https://360crm.tech/crm
# FEEDBACK_BASE_URL=https://360crm.tech/crm

# DE QUIEN SALEN LOS CORREOS DEL CRM.
#
# Si esto se queda vacio, el codigo cae en `no-reply@crm-test.local`, que es un
# dominio QUE NO EXISTE. Los correos saldrian —Brevo los acepta si el remitente
# esta dado de alta— y nadie podria contestarlos ni saber de donde vienen.
#
# El remitente tiene que estar VERIFICADO EN BREVO, no basta con que el buzon
# exista: Brevo manda en su nombre, y sin verificar rechaza el envio. Se da de
# alta en Remitentes y se confirma pulsando el enlace que llega a ese buzon.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# CORREOS DEL EQUIPO BLOQUEADOS EN BREVO (migracion 290).
#
# Brevo deja de entregar a una direccion tras un rebote duro, una baja o una
# queja de spam, y el CRM no se entera: sigue «enviando». Paso en ISEIE (17/11):
# una gestora tres semanas sin un solo aviso. Encendido, cada 6 horas se cruza
# la lista de bloqueados de Brevo (la cuenta del CRM y la de cada marca) con los
# usuarios activos; a quien aparezca se le avisa a superadmins y admins de sus
# campus (campana y correo, una vez por bloqueo) y sale marcado en Usuarios con
# el boton «Desbloquear en Brevo» (permiso users.brevo_desbloquear).
#
# APAGADO de serie: apagado no se pregunta NADA a Brevo.
# BREVO_BLOQUEADOS_ACTIVO=true
# BREVO_BLOQUEADOS_TICK_MS=21600000

# «Avisar tutor»: el correo mensual de comisiones sale de una direccion distinta
# —la de facturacion— porque le pide al tutor que CONTESTE con su factura, y esa
# respuesta tiene que caer donde alguien la lee.
#
# Si se deja vacio usa `facturacion@cediaidsl.com`, que es la cuenta de la casa.
# Vale lo mismo que arriba: verificada en Brevo o no sale.
AVISO_TUTOR_FROM=
AVISO_TUTOR_FROM_NAME=

# LA COPIA EN «ENVIADOS» DEL BUZON DE VERDAD.
#
# Brevo manda EN NOMBRE de la direccion, no DESDE ella: el correo no pasa por
# Hostinger y su carpeta de enviados no se entera. Para quien recibe es un
# correo normal; para quien lo manda, es como si no hubiera existido.
#
# Con esto puesto, el CRM deja una copia por IMAP despues de mandar — que es lo
# que hace un cliente de correo por debajo. Ojo: SMTP tampoco guarda en
# Enviados; quien guarda es el cliente, con el comando APPEND.
#
# Vacio = no se guarda copia y todo lo demas funciona igual.
#
# QUE SE PONE AQUI, sin rodeos:
#
#   IMAP_USER      el buzon de facturacion de CEDIA, que es el mismo del que
#                  salen los avisos al tutor (ver AVISO_TUTOR_FROM, arriba).
#   IMAP_PASSWORD  la contrasena de ESE buzon. La de siempre, la que se usa para
#                  entrar al webmail de Hostinger.
#
# Ojo, que son dos contrasenas distintas y se confunden: NO es la del panel de
# Hostinger (la de la cuenta), es la del buzon. Si hiciera falta cambiarla:
# hPanel -> Correos -> la cuenta -> Cambiar contrasena.
#
# LA CONTRASENA NO SE ESCRIBE NI AQUI NI EN NINGUN SITIO DEL REPOSITORIO. Este
# fichero es el ejemplo y va en git: se rellena en el `.env` del servidor, que
# no se sube.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=facturacion@cediaidsl.com
IMAP_PASSWORD=

# LA SALIDA POR EL BUZON PROPIO, para que no caiga en Promociones.
#
# Brevo engancha a todo lo que sale por ahi las cabeceras de una lista de
# correo: `List-Unsubscribe`, `List-Unsubscribe-Post`, `X-CSA-Complaints` y
# `Feedback-ID: ...Sendinblue`. Gmail las lee y archiva el correo en la pestaña
# de Promociones. No se quitan desde el mensaje —se intento pisarlas por el
# parametro `headers` de la API y Brevo las vuelve a poner—: es ajuste de
# cuenta.
#
# Saliendo por el SMTP del propio buzon no aparece ninguna, y el correo sigue
# firmado por el dominio. Para los avisos al tutor —pocos, personales, con su
# factura y pidiendo respuesta— es ademas el tubo que les corresponde.
#
# SOLO se usa para los correos que salen DESDE esta direccion. Lo demas —avisos
# de lead, bienvenidas, lo que va en volumen— sigue por Brevo. Y si el buzon
# falla, el correo cae hacia Brevo igualmente: llegar a Promociones es un
# fastidio, no llegar es un problema.
#
# Es LA MISMA CUENTA de arriba —el buzon de facturacion de CEDIA— y por eso
# estos cuatro se pueden dejar vacios: si no estan, se usan los IMAP_*. Solo hay
# que rellenarlos el dia que la salida y la lectura dejen de ser el mismo buzon.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# EL CORREO QUE ENTRA (#146).
#
# Con las credenciales de arriba puestas, el CRM lee el buzon cada media hora y
# guarda lo que ha llegado: las respuestas de los tutores con su factura, que
# hasta ahora se quedaban fuera del CRM aunque la conversacion la empezara el.
#
# Lo abre en SOLO LECTURA: no marca como leido, no borra y no mueve nada. Quien
# tenga el webmail abierto no nota que el CRM ha pasado por ahi.
#
# No hace falta configurar nada mas: usa las credenciales de arriba —el buzon de
# facturacion de CEDIA y su contrasena—. Estas dos solo estan para apagarlo o
# cambiarle el ritmo.
CORREO_ENTRANTE_TICK_MS=1800000
# CORREO_ENTRANTE_DISABLED=1

# El freno: fuera de produccion no sale ni un correo a un cliente real.
#
# Direcciones separadas por comas. Admite dominios enteros con @:
#   EMAIL_LISTA_BLANCA=admin@empresa.com,pruebas@gmail.com
#
# En produccion (NODE_ENV=production) esta variable NO se mira y sale todo.
# Fuera de produccion, si esta vacia NO SALE NINGUN CORREO — a proposito: quien
# monte un entorno y se olvide de ponerla se queda sin correos, que es un
# problema visible y sin consecuencias. Dejar pasar todo por defecto seria un
# problema invisible que se come un cliente.
#
# Basta con que UN destinatario no este en la lista para no mandar el correo a
# nadie: los avisos a administradores van a varias direcciones a la vez.
EMAIL_LISTA_BLANCA=

# Aviso «prospecto sin contactar» (tarea #28).
# A los cuantos minutos avisar a su gestora, y cada cuanto se comprueba.
LEAD_SIN_TOCAR_MINUTOS=30
LEAD_SIN_TOCAR_TICK_MS=300000
# Para apagarlo del todo en un entorno:
# LEAD_SIN_TOCAR_DISABLED=1

# Consultas de alumnos (#187): cada hora se pregunta al Moodle de cada campus
# conectado en Integraciones si el correo de cada tutor sigue siendo usuario. Si
# le dan de baja, se marca y deja de recibir consultas de ese campus. Sin campus
# conectados no hace nada. Al abrir la ficha de un tutor se vuelve a comprobar
# si la ultima comprobacion tiene mas de TUTORES_CAMPUS_FRESCA_MS (30 s).
# Cuanto espera a cada Moodle, en ms:
# MOODLE_TIMEOUT_MS=10000
# Si el campus contesta «Database connection failed» (su base, llena), la llamada se
# repite estas veces (no ha hecho nada en Moodle). Un 5xx o una conexión cortada se
# repiten solo en las funciones que leen (…_get_…). Antes de cada repetición se espera
# MOODLE_REINTENTO_MS × nº de intento, más hasta un tercio al azar (1,5-2 s; 3-4 s; 4,5-6 s).
# MOODLE_REINTENTOS_BD=3
# MOODLE_REINTENTO_MS=1500
# Freno común a TODAS las llamadas del proceso a TODOS los Moodle (tareas, Mi campus, MCP):
# el hosting de los campus de CEDIA admite 20 conexiones nuevas a MySQL por segundo para
# toda la cuenta (nueve Moodle y sesenta webs) y rechaza las de más. Como mucho
# MOODLE_LLAMADAS_POR_SEGUNDO empiezan cada segundo y MOODLE_LLAMADAS_A_LA_VEZ están en
# curso. Lo que pide una persona pasa delante de lo que piden las tareas programadas.
# Con las dos a 0 no frena nada (como antes del 27/11).
# MOODLE_LLAMADAS_POR_SEGUNDO=4
# MOODLE_LLAMADAS_A_LA_VEZ=2
# Nadie espera turno para siempre: una persona, como mucho MOODLE_ESPERA_TURNO_MS (y
# entonces «campus ocupado, inténtalo en un momento»); una tarea programada,
# MOODLE_ESPERA_TURNO_FONDO_MS. 0 = sin tope. Si la persona cierra la página, sus llamadas
# que aún esperan salen de la cola.
# MOODLE_ESPERA_TURNO_MS=30000
# MOODLE_ESPERA_TURNO_FONDO_MS=300000
# El freno es POR PROCESO: producción y pruebas de los dos CRM suman contra el mismo tope del
# hosting. En pruebas (/testeo, /staging), MOODLE_LLAMADAS_POR_SEGUNDO=1 y MOODLE_LLAMADAS_A_LA_VEZ=1.
# Cada tarea programada sale con un desfase fijo propio (sale de su nombre), para que las
# de 5, 15, 60 y 120 minutos no coincidan en el mismo segundo. Tope del desfase, en ms
# (y nunca más de medio intervalo); 0 lo quita.
# TAREAS_DESFASE_MAX_MS=600000
# «Mi campus»: llamadas a la vez a cada campus (con 4, el servidor de los campus de
# CEDIA rechazaba conexiones) y tope de conversaciones privadas que se miran por
# tutora para sacar los mensajes sin responder.
# MI_CAMPUS_PARALELO=2
# MI_CAMPUS_MAX_CONVERSACIONES=300
# TUTORES_CAMPUS_TICK_MS=3600000
# TUTORES_CAMPUS_FRESCA_MS=30000
# TUTORES_CAMPUS_DISABLED=1

# Plugin del CRM en cada Moodle (#679). La direccion publica de la API, la que el
# plugin llama desde el campus (va dentro del codigo de conexion). Sin ella se usa
# CRM_BASE_URL + /api, con su ruta: con CRM_BASE_URL=https://360crm.tech/testeo sale
# https://360crm.tech/testeo/api (/testeo nunca apunta a la API de produccion).
# API_PUBLIC_BASE_URL=https://360crm.tech/api
# Solo en local: deja conectar un Moodle en Docker (http, red interna). Nunca en produccion.
# MOODLE_PERMITIR_RED_LOCAL=true
# Actualización automática del plugin: la clave PRIVADA con la que se firma cada versión
# (npm run plugin:publicar). Solo en el servidor, nunca en el repo. La pública va en el
# plugin (crm/classes/claves.php de local_crm, en molinangel/Campus-Moodle).
# PLUGIN_FIRMA_CLAVE_ARCHIVO=/opt/crm/claves/plugin-moodle-privada.pem
# De dónde sale el plugin que se publica: la carpeta local_crm de un clon de Campus-Moodle (#1037).
# PLUGIN_MOODLE_ORIGEN=/ruta/a/Campus-Moodle/local_crm
# Dónde se publica (y de dónde lo sirve /api/moodle-avisos/plugin/ultima). Por defecto backend/plugin-moodle
# PLUGIN_MOODLE_DIR=
# El repaso de los campus con el plugin (cada 15 min): se apaga con MOODLE_SINCRONIZACION_DISABLED=1
# MOODLE_SINCRONIZACION_TICK_MS=900000
# Tope de avisos por minuto de cada campus (por IP); pasado, 429 y el plugin reintenta luego.
# MOODLE_AVISOS_POR_MINUTO=600

# Google OAuth (compartido para todos los proyectos — F2-014)
# Obtener en https://console.cloud.google.com → APIs & Services → Credentials.
# El refresh_token de cada cuenta se guarda en api_credentials.encrypted_value
# (service='google_ads'). El cron googleAdsTokenScheduler valida diariamente.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Opcional: deshabilita el cron de validacion (1=off, vacio=on)
# GOOGLE_TOKEN_DISABLED=
# Intervalo de cron en ms (default 24h)
# GOOGLE_TOKEN_TICK_MS=86400000

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=info
# ── WhatsApp ─────────────────────────────────────────────────────────────────
#
# El CRM habla con un servicio que expone los endpoints de Evolution API. En los
# dos servidores hay Evolution en Docker; en local se puede usar un puente con
# Baileys que imita esos mismos endpoints, porque Docker no arranca en todas las
# maquinas. El CRM no distingue cual de los dos hay detras.
#
# Sin EVOLUTION_URL y EVOLUTION_API_KEY el modulo se queda inerte y lo avisa —no
# rompe nada—, porque comprueba si esta configurado antes de llamar.

# Donde escucha. Escucha SOLO en 127.0.0.1: no se expone al exterior.
#   MultiCRM: http://127.0.0.1:8080
#   ISEIE:    http://127.0.0.1:8081   (el 8080 lo ocupa Nginx)
EVOLUTION_URL=http://127.0.0.1:8080

# La clave que protege Evolution. NO se pide a nadie: te la inventas y la pones
# igual en los dos sitios — aqui y en AUTHENTICATION_API_KEY del compose.
#   openssl rand -hex 32
EVOLUTION_API_KEY=

# Prefijo de las sesiones. Cada usuario tiene la suya: crm-u7, crm-u12...
# El id del usuario va dentro del nombre, y de ahi sale el aislamiento.
#
# CAMBIALO EN CADA ENTORNO. Si pruebas y produccion comparten prefijo, comparten
# sesiones: alguien probando en /testeo DESCONECTA el WhatsApp de una gestora
# que esta trabajando. En produccion «crm», en pruebas «testeo».
EVOLUTION_INSTANCIA=crm

# A DONDE AVISA EVOLUTION cuando entra un mensaje de una sesion de este entorno.
#
# Vacio = se usa el webhook global del contenedor, que apunta a un solo sitio; y
# entonces los mensajes de pruebas acaban en la base de produccion. Ponla siempre
# que haya mas de un entorno contra el mismo Evolution.
#   http://172.17.0.1:3002/api/whatsapp/webhook?s=EL_MISMO_SECRETO
EVOLUTION_WEBHOOK_URL=

# OBLIGATORIO en produccion: sin el, el webhook responde 503 y no procesa nada.
#
# Esa ruta va ANTES del verifyToken —la llama el contenedor, no un navegador—,
# asi que dejarlo vacio permitiria a cualquiera que supiera la direccion meter
# mensajes inventados en la conversacion de una gestora.
#
# Se acepta en la cabecera x-webhook-secret o dentro de la propia direccion: el
# webhook GLOBAL de Evolution no deja mandar cabeceras propias, y con el secreto
# solo por cabecera habria rechazado TODOS los mensajes entrantes.
#   openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=

# ¿Entran los grupos de WhatsApp? 'si' (por defecto) o 'no'.
#
# Esto vivia como `groupsIgnore: true` en la llamada a Evolution y NO se
# cumplia: en la base de pruebas habia 2 grupos de 5 conversaciones, con
# mensajes del mismo dia. Tres motivos a la vez — el puente de Baileys no
# implementa el flag, `guardarAjustes` lo apagaba al tocar el interruptor de
# llamadas, y el propio CRM aceptaba grupos a proposito.
#
# El valor por defecto es 'si' porque es lo que YA pasa hoy en los dos entornos;
# ponerlo en 'no' habria sido colar un cambio de comportamiento dentro de un
# arreglo. Con 'no' los grupos dejan de entrar DE VERDAD —lo aplica el CRM, no
# el proveedor— y tampoco se ensenan los que ya estuvieran guardados.
#
# A favor de 'no': este numero es para escribir a prospectos y cada interaccion
# rara suma para que WhatsApp lo suspenda. A favor de 'si': hay grupos de
# trabajo que las gestoras usan, y es lo que pide la tarea #74.
WHATSAPP_GRUPOS=si

# Los frenos que protegen el numero. Lo que hace que WhatsApp suspenda una linea
# no es tanto detectar el cliente como que la gente la bloquee y la reporte, asi
# que estos numeros son conservadores a proposito. Son POR NUMERO.
WA_TOPE_MINUTO=6
WA_TOPE_HORA=60
WA_TOPE_DIA=300
WA_PAUSA_MS=1500

# Cuantos dias de historial de adjuntos se bajan solos al enlazar. Lo de ahora se
# baja siempre y con prioridad; lo mas viejo sale como «Descargar» en el chat.
# Sin tope, un movil de anos mete 17.000 archivos en la cola y lo que envias se
# pone detras de todos.
WA_MEDIA_DIAS=30

# Intentos antes de dar un adjunto por perdido (#638). Lo que Evolution ya no tiene
# («Message not found») no vuelve: sin tope se pedia otra vez en cada arranque.
WA_MEDIA_INTENTOS=3

# Donde se guardan los adjuntos ya descargados.
UPLOADS_DIR=/var/crm-uploads

# El freno de escribir a desconocidos. VIENE APAGADO — decision de Diego,
# 21/08/2026.
#
# Impedia el primer mensaje a un numero que no fuera prospecto y que nunca
# hubiera escrito. No evitaba nada: la gestora escribia igual desde su movil,
# pero sin registro, sin plantilla y sin los topes de ritmo de arriba.
#
# Escribir a quien no pidio informacion sigue siendo lo que hace que reporten un
# numero, asi que queda apuntado en el registro. El freno ahora es saberlo, no
# impedirlo. Para volver a frenar, true — pero eso se habla antes con Diego.
#
# La variable vieja se llamaba WA_EXIGIR_CONSENTIMIENTO y significaba lo
# CONTRARIO. Si sigue en algun .env, el servidor la ignora y lo avisa al
# arrancar; quitala.
WA_BLOQUEO_DESCONOCIDOS=false


# Volcado de la FORMA de los avisos de WhatsApp. Apagado salvo para diagnosticar.
#
# Con esto a 1, el CRM apunta la ESTRUCTURA de los primeros avisos de cada tipo
# que manda Evolution: que claves vienen, de que tipo, y si `data` llega como
# objeto o como lista. NO guarda textos, telefonos ni nombres — solo la forma,
# que es lo que hace falta para saber donde mirar.
#
# Se lee en GET /api/whatsapp/forma-avisos (soporte o superadmin) y se puede
# pegar en un issue sin pensarlo. Vive en memoria: se va al reiniciar.
WHATSAPP_VOLCAR_FORMA=0

# --- Certifex: consultas de su web y emision de titulos desde el CRM ---
# Consultas: Certifex entrega aqui cada consulta de su web (POST /api/certifex/consultas)
# con este secreto en la cabecera X-Certifex-Secreto. El MISMO valor va en el .env de
# Certifex como CRM_CONSULTAS_SECRETO. Generalo con `openssl rand -hex 32`. Sin el, la
# entrada esta cerrada (404).
# CERTIFEX_WEBHOOK_SECRETO=
#
# Emisiones (Certifex -> Emisiones): el CRM da el visto bueno y emite en Certifex.
# La clave la genera Certifex en SU servidor con `npm run crm:clave`, que la escribe en
# un fichero 600 (no sale por pantalla). Solo va aqui, en el servidor: el navegador no la
# ve nunca. En cuanto un campus tiene clave de CRM, Certifex no le emite nada sin OK.
# CERTIFEX_API_URL=https://certifex.tech
# CERTIFEX_CRM_CLAVE=cfx_crm_...
# Repaso de diplomas revertidos (#624), cada 10 min; se apaga con:
# CERTIFEX_REVERSIONES_DISABLED=1
# Web publica de Certifex (verificacion y diplomas), si algun dia no es la de la API:
# CERTIFEX_PUBLICO_URL=
#
# Las pantallas (Matriculas -> Certificaciones y Diplomas) se encienden en el FRONTAL con
# VITE_CERTIFEX_PANEL=1 (apagadas en produccion si no se pone). El mismo
# CERTIFEX_WEBHOOK_SECRETO protege la entrada de solicitudes de diploma
# (POST /api/certifex/solicitudes). Guia completa: docs/README.md, «Certifex: enlace en
# produccion».

# ── MCP de Claude · código de desbloqueo (#192) ─────────────────────────────
# Con «true», Claude no saca ningún dato hasta que la persona le da el código
# de CRM → Conexión → MCP → «Código para Claude». Apagado por defecto: encenderlo
# sin avisar dejaría sin servicio a quien ya lo usa.
MCP_CODIGO_OBLIGATORIO=false
# Minutos que vale un código recién pedido (un solo uso).
MCP_CODIGO_MINUTOS=10
# El desbloqueo ya no caduca por horas (#326): vale para cada Claude conectado
# mientras su dueño lo tenga autorizado y la URL siga viva.
# Al desplegar la #326, la PRIMERA conexión de Claude de cada URL que ya existía:
# true = entra autorizada (nadie tiene que ir al CRM a autorizarla);
# false = queda pendiente, como cualquier otra, hasta que su dueño la autorice.
# Las demás siempre quedan pendientes. Lo decide Diego al pasar a producción.
MCP_CONEXIONES_EXISTENTES_APROBADAS=false
# Códigos incorrectos seguidos antes de bloquear la conexión, y minutos de bloqueo.
MCP_CODIGO_MAX_FALLOS=5
MCP_CODIGO_BLOQUEO_MIN=15
# A quién más avisar por correo al bloquearse (separados por comas). Vacío = super admins.
MCP_AVISO_EMAIL=

# ── MCP de Claude · caducidad y rotación de URLs (#194) ─────────────────────
# Días que vive una URL desde que se crea (0 = no caducan).
MCP_TOKEN_DIAS=90
# Días antes de caducar en que se avisa por correo al dueño.
MCP_TOKEN_AVISO_DIAS=7
# Días sin usarse tras los que una URL se revoca sola (0 = nunca).
MCP_TOKEN_SIN_USO_DIAS=30
# Cada cuánto se revisa (ms). Por defecto, 6 horas.
MCP_ROTACION_TICK_MS=21600000

# ── MCP de Claude · auditoría visible y alertas (#195) ──────────────────────
# Alertas por correo a quien vigila (MCP_AVISO_EMAIL o los super admin). false = ninguna.
MCP_ALERTAS=true
# Ráfaga: más de N consultas de una persona en M minutos (0 = apagada).
MCP_ALERTA_RAFAGA_CONSULTAS=100
MCP_ALERTA_RAFAGA_MINUTOS=10
# Una red (/24) o un cliente (claude-code, Claude-User…) nuevos para esa persona.
MCP_ALERTA_ORIGEN_NUEVO=true
# Fallos del código de desbloqueo en una hora (0 = apagada).
MCP_ALERTA_FALLOS_DESBLOQUEO=3
# Franja de madrugada, horas locales «desde-hasta» (vacío = apagada).
MCP_ALERTA_MADRUGADA=0-6
# Cada cuánto se revisa (ms). Por defecto, 5 minutos.
MCP_ALERTAS_TICK_MS=300000
# Meses que se guarda la auditoría (0 = siempre).
MCP_AUDITORIA_MESES=12

# ── MCP de Claude · interruptor y datos personales (#196) ───────────────────
# 1 = apaga TODO el MCP desde el servidor (el botón del panel no lo enciende).
MCP_DISABLED=0
# Máximo de filas de cualquier lista en una respuesta a Claude.
MCP_MAX_FILAS=100

# ── MCP de Claude · Moodle de los campus (#335) ─────────────────────────────
# La URL y el token de cada Moodle NO van aquí: están cifrados en las claves del
# CRM (Configuración → Claves, servicio «Moodle», una por campus). Aquí solo los
# límites. Todos son opcionales.
# Minutos que se guarda la lista de cursos de cada campus (0 = sin caché).
MCP_MOODLE_CACHE_MIN=5
# Máximo de campus/listas en la caché.
MCP_MOODLE_CACHE_MAX=50
# Tiempo máximo de UNA petición a Moodle y de una herramienta entera (ms).
MCP_MOODLE_TIMEOUT_MS=8000
MCP_MOODLE_TOPE_MS=25000
# Enlaces que se comprueban como máximo por petición (tope duro 100) y tiempo por enlace (ms).
MCP_MOODLE_MAX_ENLACES=30
MCP_MOODLE_ENLACE_TIMEOUT_MS=4000
# Matriculados que se leen como máximo de UN curso.
MCP_MOODLE_MAX_ALUMNOS=5000
# «Terminados» cuesta una llamada a Moodle por alumno: solo se pregunta en cursos
# con hasta tantos alumnos (más, sale null con el motivo).
MCP_MOODLE_MAX_TERMINADOS=150
# «Para revisar» (Conexión → Moodle → un campus) lee los cursos activos UNO A UNO de un Moodle en
# producción: se hace con poca presión a propósito (con 5 a la vez el de Psiko saturó su base de
# datos). Lecturas a la vez, pausa entre cursos, cuánto trabaja cada petición, cuánto se guarda
# lo leído y cuánto espera si Moodle dice que va justo de carga.
MCP_MOODLE_REVISION_CONCURRENCIA=2
MCP_MOODLE_REVISION_PAUSA_MS=150
MCP_MOODLE_REVISION_MS=12000
MCP_MOODLE_REVISION_MIN=10
MCP_MOODLE_REVISION_ESPERA_MS=30000
# Aviso a los super admin si el Moodle de un campus deja de responder (cada cuántos ms se mira;
# MOODLE_AVISOS_DISABLED=1 lo apaga).
MOODLE_AVISOS_TICK_MS=10800000

# ── Tablero de tareas (#210) ────────────────────────────────────────────────
# El tablero aún NO está aprobado para producción (Diego, 07/10). Con
# NODE_ENV=production, /api/tasks y el correo de cada mañana solo se montan si
# CRM_BASE_URL apunta a /testeo (el servidor de pruebas TIENE que tenerla así,
# p. ej. https://360crm.tech/testeo) o si se aprueba con TAREAS_EN_PRODUCCION=1.
# Es el espejo de SOLO_EN_PRUEBAS del frontal.
TAREAS_EN_PRODUCCION=0
# Correos a las personas de las tareas: asignada, devuelta, aprobada,
# comentario nuevo y el de cada mañana. APAGADO por defecto: el CRM arma cada
# correo y lo registra en el log (para quién y asunto), pero no llama a Brevo.
# Lo enciende Diego en producción cuando lo decida (true o 1).
TAREAS_CORREOS_ACTIVOS=false
# El correo de cada mañana: a qué hora (0-23) en la zona de la oficina
# (APP_TIMEZONE, por defecto Europe/Madrid; el servidor está en UTC) y cada
# cuánto se comprueba.
TAREAS_DIARIO_HORA=8
TAREAS_DIARIO_TICK_MS=1800000
# Para no programarlo siquiera en un entorno:
# TAREAS_DIARIO_DISABLED=1
# El resumen de la tarde (Diego, 26/10/2026): de lunes a viernes, lo que cada
# uno hizo hoy en el tablero y lo que le falta. A la hora de TAREAS_RESUMEN_HORA
# ("18" o "18:30") en TAREAS_RESUMEN_ZONA (Venezuela). Encendido salvo que se
# ponga false. Una vez al día por persona (tabla task_daily_summaries, migr. 227).
TAREAS_RESUMEN_ACTIVO=true
TAREAS_RESUMEN_HORA=18
TAREAS_RESUMEN_ZONA=America/Caracas
# El correo de cambio de estado: si una tarea se mueve varias veces en estos
# segundos, sale un solo correo con el último estado (0 = al momento, sin agrupar).
TAREAS_ESTADO_AGRUPAR_SEG=120
# El tablero, al día con las issues de GitHub (CRM#737). APAGADO de serie: sin
# true (o 1) no se monta /api/github/webhook (404) y el guion de importación no
# escribe. El secreto del webhook y el token de solo lectura NO van aquí: se
# guardan cifrados desde Configurar tablero › GitHub (servicio «github»).
GITHUB_TABLERO_ACTIVO=false

# ── Facturas de colaboradores (#202) ────────────────────────────────────────
# El enlace del mes (último día, 10:00 de Madrid), el recordatorio del día 5,
# el acuse con la copia y el enlace nuevo al anular o reenviar. APAGADO por
# defecto: el CRM arma cada correo y lo registra en el log (para quién y
# asunto), pero no llama a Brevo. Lo enciende Diego en producción (true o 1).
# Facturas de colaboradores (#202): solo en pruebas también en el servidor. En producción
# no se monta la API ni la tarea del mes hasta aprobarlo con =1.
FACTURAS_COLABORADOR_EN_PRODUCCION=0
# Proyectos IA (#44, PR #386 y #387): solo en pruebas también en el servidor. En
# producción no se montan /api/ia/cobros ni /api/ia/supabase/*, ni se acepta la
# integración `supabase`, hasta aprobarlo con =1. /api/ia/metrics y /api/ia/gasto
# no dependen de esto. El frontal lo esconde con SOLO_EN_PRUEBAS.
PROYECTOS_IA_EN_PRODUCCION=0
# Plugin del CRM en cada Moodle (#679, PR #689): solo en pruebas también en el servidor.
# En producción no se monta /api/moodle-avisos ni el repaso de los campus, no se dan
# códigos de conexión y la tutora responde como hasta ahora (con su token del campus),
# hasta aprobarlo con =1. El frontal esconde el bloque de Integraciones con SOLO_EN_PRUEBAS.
PLUGIN_MOODLE_EN_PRODUCCION=0
# Las tutoras redactoras en Moodle (CRM#1026): en la ficha de Tutores, si su cuenta de cada
# campus está lista y si es profesora de los cursos que redacta. Solo lee del Moodle. En
# producción no se monta GET /api/tutores/:id/redaccion-moodle hasta aprobarlo con =1. El
# frontal lo esconde con SOLO_EN_PRUEBAS.
REDACTORAS_MOODLE_EN_PRODUCCION=0

# Formaciones desde el CRM, fase 2 (CRM#1113): «Crear / Actualizar en Moodle» en
# Productos › Formaciones crea el curso de la formación en el Moodle del campus, con
# una sección por módulo. ESCRIBE en Moodle: apagado en producción hasta que se
# apruebe. Necesita además PLUGIN_MOODLE_EN_PRODUCCION=1 y el plugin 1.12.0 en el campus.
FORMACIONES_MOODLE_EN_PRODUCCION=0
# Links de pago de Stripe (#680): en producción no se monta /api/links-pago, no arranca
# su caducidad ni se acepta la clave `stripe_links` hasta encenderlo con =1. Es lo ÚNICO
# de los links que va en el .env: claves, reglas y webhook se ponen desde la web
# (Integraciones › Links de pago). El frontal lo sabe por /auth/me (user.funciones):
# encenderlo es cambiar esto y reiniciar la API, sin compilar el frontal.
LINKS_PAGO_EN_PRODUCCION=0
# Seguimiento de los links que no se pagan (CRM#984): cada 15 minutos mira qué links
# ha abierto el alumno en Stripe, avisa a la gestora si lo abrió y no pagó (a las
# horas que diga el campus) y manda al alumno el recordatorio de las 24 h y de las
# 72 h por correo. APAGADO en producción hasta encenderlo con =1; en pruebas, siempre
# (los correos pasan por el freno de pruebas). Renovar un caducado no depende de esto.
LINKS_PAGO_SEGUIMIENTO_EN_PRODUCCION=0
# El mismo recordatorio también por WhatsApp, por la conversación que la gestora ya
# tenga con el prospecto. APAGADO en TODOS los entornos salvo =1: WhatsApp no tiene
# freno de pruebas. Necesita además el seguimiento encendido.
LINKS_PAGO_RECORDATORIO_WHATSAPP=0
FACTURAS_COLABORADOR_CORREOS_ACTIVOS=false
# Los avisos a la empresa (Diego, 04/11), al correo de facturación de cada una
# (el correo de la empresa emisora): «Han llegado N facturas» cuando los colaboradores
# suben las suyas (juntas si llegan seguidas) y, desde las 09:00, el resumen
# diario «Faltan N facturas por pagar». Cada uno se apaga con su =1.
# FACTURAS_COLABORADOR_LLEGADAS_DISABLED=1
# FACTURAS_COLABORADOR_POR_PAGAR_DISABLED=1

# ── Factura automática con formulario de datos fiscales (#764) ─────────────
# APAGADA de serie: sin FACTURA_AUTOMATICA_ACTIVA=1 el cobro sigue el camino de
# hoy y no sale ningún correo. Encendida: al primer pago de una venta se le manda
# al alumno un enlace (firmado, de un solo uso) a un formulario con sus datos
# fiscales; al enviarlo, la factura de ese pago sale sola por el circuito de la
# cola (y la de cada cuota, con los mismos datos). A los N días sin respuesta,
# con los de la ficha SOLO si están completos y son válidos; si no, el cobro se
# queda en la cola y se avisa a su gestora.
FACTURA_AUTOMATICA_ACTIVA=0
# Campus en los que va (ids o slugs, separados por comas). Vacío = todos.
# FACTURA_AUTOMATICA_CAMPUS=
# Días para contestar (7) y envíos con errores que admite el enlace (5).
# FACTURA_AUTOMATICA_DIAS=7
# FACTURA_AUTOMATICA_INTENTOS=5
# =0 para emitir la factura sin mandarle el PDF al alumno.
# FACTURA_AUTOMATICA_ENVIAR_PDF=1
# FACTURA_ENVIO_REVISION_ADMIN=1    # (25/11) la factura automática no se manda al alumno ni se le pide el formulario:
#                                   sale con los datos de la ficha y queda «Por enviar» en Facturación
#                                   para administración. ISEIE: 1. Apagado (de serie): como hasta hoy.
# Cada cuánto mira los plazos (ms; 30 min).
# FACTURA_AUTOMATICA_TICK_MS=1800000

# ── Confirmación de datos del diploma (#768, migración 291) ─────────────────
# APAGADA de serie: sin DIPLOMA_CONFIRMACION_ACTIVA=1 la emisión de diplomas es
# la de hoy. Encendida en un campus: antes de emitir, el alumno recibe un enlace
# (firmado, de un solo uso) con los datos de su diploma para confirmarlos o
# corregir nombre y documento; sin esa confirmación (o sin que pasen los N días)
# Diplomas no emite. El diploma lo sigue emitiendo una persona.
DIPLOMA_CONFIRMACION_ACTIVA=0
# Campus de Certifex en los que va («ISEIH,PSIKO»). Vacío = todos.
# DIPLOMA_CONFIRMACION_CENTROS=
# Días para contestar (7) y envíos con errores que admite el enlace (5).
# DIPLOMA_CONFIRMACION_DIAS=7
# DIPLOMA_CONFIRMACION_INTENTOS=5
# =1 para que el correo salga de verdad. Apagado, se apunta como simulado y a
# quien lo pide se le devuelve el enlace para probarlo.
# DIPLOMA_CONFIRMACION_ENVIAR_CORREO=0
# Cada cuánto mira los plazos (ms; 30 min).
# DIPLOMA_CONFIRMACION_TICK_MS=1800000
# Paso 1 (plugin local_crm 1.14.0): cuando Moodle avisa de que el alumno ha
# terminado un curso con todo corregido, pedir la confirmación sola (sin el
# «Pedir datos» a mano). APAGADO de serie; necesita además ACTIVA=1 y el campus
# en CENTROS. Apagado, el aviso se contesta y no se hace nada.
DIPLOMA_CONFIRMACION_AUTO=0

# ── Matrícula automática en Moodle (#767) ───────────────────────────────────
# APAGADA de serie. Encendida: con el primer pago de una venta se programa la
# matrícula del alumno para el día anterior a su fecha de inicio (o para ya si
# no tiene o ya pasó), y si se borra la venta o el pago se cancela. Cada hora,
# las que tocan se comprueban (correo del alumno, curso de Moodle del producto)
# y quedan «listas» con aviso en la campana a administración del campus; si
# falta algo se reintenta, y al agotar los intentos se avisa del fallo con el
# motivo.
# FASE 2 (#767): si el campus tiene el plugin local_crm 1.12.0 conectado, la
# matrícula se hace en Moodle (local_crm_matricular) y se le manda al alumno su
# correo de bienvenida con el enlace para poner la contraseña, con la marca y el
# remitente de su campus. Sin plugin conectado, como en la fase 1: «lista» y a
# mano.
# Necesita la migración 289 aplicada ANTES de encenderlo.
MATRICULA_MOODLE_ACTIVA=0
# Campus en los que va (ids o slugs, separados por comas). Vacío = todos.
# MATRICULA_MOODLE_CAMPUS=
# Vueltas con fallo antes de darla por fallida (5) y hora de Madrid del día
# anterior al inicio a la que se programa (8).
# MATRICULA_MOODLE_INTENTOS=5
# MATRICULA_MOODLE_HORA=8
# Cada cuánto mira (ms; 1 hora).
# MATRICULA_MOODLE_TICK_MS=3600000
# Correo también a quien YA tenía cuenta en el campus (sus cursos nuevos y
# «¿Has olvidado tu contraseña?»). Apagado de serie: pendiente de decidir. Al
# alumno nuevo se le manda siempre.
MATRICULA_MOODLE_CORREO_EXISTENTES=0

# ── Webhook de transferencias (Conexión, migración 206) ─────────────────────
# El aviso a fuera de los cobros por transferencia o depósito bancario. Se
# configura en la pantalla; aquí solo los tiempos. El secreto de cada webhook
# se cifra con ENCRYPTION_KEY.
# Cuánto se espera la respuesta del destino (ms).
WEBHOOKS_SALIENTES_TIMEOUT_MS=10000
# Cada cuánto se revisan los reintentos (ms). Por defecto, 2 minutos.
WEBHOOKS_SALIENTES_TICK_MS=120000
# 1 = no se hacen los reintentos (el primer envío sí sale).
WEBHOOKS_SALIENTES_DISABLED=

# ── Soporte (#38, migración 230) ──────────────────────────────────────────
# A dónde llega el correo cuando alguien abre un ticket. Vacío = no sale ningún
# correo: el ticket se guarda igual y avisa por la campana, pero nadie lo lee en
# el buzón. Un solo correo; el equipo de soporte, no una persona.
SOPORTE_EMAIL=

# ── IA: preguntar a los datos y lectura de la semana (#30, #22) ────────────
# Ninguna de las dos gasta nada hasta que hay clave de Anthropic (Ajustes → APIs
# o ANTHROPIC_API_KEY). Y todas pasan por el tope de gasto del mes.
#
# Tope de gasto del mes, en USD. Vacío = 20. 0 = sin tope (solo se apunta el gasto).
# Se mira ANTES de cada llamada, no al terminar.
IA_TOPE_MENSUAL_USD=
# Preguntas por minuto y persona en «Pregunta a tus datos». Vacío = 8. Cada
# pregunta son varias llamadas a Anthropic y cada una se paga.
IA_PREGUNTAS_POR_MINUTO=
# 1 = el reporte semanal de dirección lleva «Lectura de la semana», escrita por IA.
# Apagado por defecto. Si la IA falla, no hay clave o alguna cifra del texto no sale
# de los datos, el correo sale sin ella.
# Diego (10/11/2026): las pantallas de IA del CRM están apagadas —se usa Claude por
# el MCP—; esta se deja vacía. En el frontal, `VITE_PANTALLAS_IA` (#30).
IA_ANALISIS_SEMANAL=

# Consultas de alumnos (#188): cada 5 minutos se leen las conversaciones de los
# tutores en los campus con «Leer las consultas» marcado en Integraciones. Menos los
# que tienen el plugin del CRM al día (#689): plugin activo y un repaso bueno en los
# últimos 2×MOODLE_SINCRONIZACION_TICK_MS + 5 min. Con el repaso apagado, se leen todos.
# Plazo de primera respuesta (semaforo) y caducidad del enlace de los adjuntos.
# CONSULTAS_PLAZO_HORAS=24
# CONSULTAS_ADJUNTO_DIAS=90
# CONSULTAS_CAMPUS_TICK_MS=300000
# CONSULTAS_CAMPUS_DISABLED=1

# Consultas de alumnos, fase 3 (#189): los alumnos de cada tutor (una vez al dia),
# el semaforo de «Alumnos sin mensajes» (ambar y rojo, en dias), el plazo de la
# carga de trabajo (dias) y el resumen semanal al tutor (lunes, hora de Madrid).
# CONSULTAS_ALUMNOS_TICK_MS=86400000
# CONSULTAS_ALUMNOS_DISABLED=1
# CONSULTAS_SIN_MENSAJES_AMBAR=5
# CONSULTAS_SIN_MENSAJES_ROJO=7
# CONSULTAS_CARGA_DIAS=7
# CONSULTAS_RESUMEN_HORA=9
# CONSULTAS_RESUMEN_DISABLED=1

# Consultas de alumnos, fase 4 (#190): recordatorio al tutor cuando una consulta
# se acerca al plazo (las 3/4 partes) y aviso a administracion cuando se pasa
# (cada 15 minutos); recordatorio de carga de trabajo desactualizada (se mira
# una vez al dia y se repite como mucho una vez por semana).
# CONSULTAS_PLAZO_TICK_MS=900000
# CONSULTAS_PLAZO_DISABLED=1
# #769: horas de espera para cada escalón (sin ponerlas, 3/4 del plazo y el plazo).
# Lo que pidió Manuel: recordatorio al tutor a las 24 h y aviso a administración a las 48 h.
# El aviso a administración, también por correo con =1 (apagado por defecto).
# CONSULTAS_RECORDATORIO_HORAS=24
# CONSULTAS_AVISO_ADMIN_HORAS=48
# CONSULTAS_AVISO_ADMIN_CORREO=1
# CONSULTAS_CARGA_TICK_MS=86400000
# CONSULTAS_CARGA_RECORDATORIO_DISABLED=1

# Mi campus (#681): aviso a la tutora de cada entrega que lleva más de 48 h sin
# corregir (un correo por tutora y vuelta, cada entrega una sola vez; respeta el
# freno de correos a tutores). Solo arranca con PLUGIN_MOODLE_EN_PRODUCCION=1 en
# producción (en /testeo y en local, siempre). Cada 2 horas.
# ENTREGAS_SIN_CORREGIR_TICK_MS=7200000
# ENTREGAS_SIN_CORREGIR_DISABLED=1
# El segundo escalón (#769), en la misma vuelta: a administración del campus, las
# que siguen sin corregir a los N días naturales de entregarlas (5 de serie) o en su
# «Recordarme calificar antes de» si llega antes; y, a las 48 h, las de cursos sin
# tutora en el CRM (necesita el plugin 1.10.8). Campana siempre; correo solo con
# CONSULTAS_AVISO_ADMIN_CORREO=1, el mismo interruptor que las consultas.
# ENTREGAS_AVISO_ADMIN_DIAS=5
# Con más alumnos que esto en un campus, «Mi campus» no lee el % hecho de cada uno
# (una llamada a Moodle por alumno) y lo dice en el curso.
# MI_CAMPUS_MAX_PROGRESO=300
# La pestaña «Campus» de la ficha del cliente (#532): un curso sale «sin acceso» si el
# alumno lleva más de estos días sin entrar (14 de serie). Va con el plugin aprobado
# (PLUGIN_MOODLE_EN_PRODUCCION); las notas necesitan el plugin 1.10.9 en el campus.
# AVANCE_MOODLE_DIAS_SIN_ACCESO=14

# Aviso de una solicitud de admisión nueva (#714): un correo SIN DATOS (campus,
# curso, número de solicitud y enlace a la ficha) a las direcciones del webhook de
# admisión del campus (Matrículas -> Webhooks). Los datos y los documentos se
# quedan solo en el CRM. Apagado se arma y se anota, pero no sale.
ADMISION_AVISO_ACTIVO=false

# Copia diaria de la base, cifrada y por correo (11/11/2026). Cada dia, a la hora
# de Madrid, un pg_dump de la base de DATABASE_URL (sin dueño ni permisos) en un
# zip AES-256 que abren 7-Zip y WinRAR, mandado por Brevo a COPIA_DIARIA_PARA.
# Si el zip pasa de COPIA_DIARIA_MAX_ADJUNTO_MB no se adjunta: va un enlace de
# descarga firmado que caduca a las COPIA_DIARIA_ENLACE_HORAS (solo da el zip
# cifrado). Se guardan las COPIA_DIARIA_GUARDAR ultimas en COPIA_DIARIA_CARPETA
# (700, fuera de la carpeta web; de serie ~/copias-crm/<base>). Necesita pg_dump
# en el servidor, de la misma version que Postgres o mas nueva.
# Apagada de serie. Sin COPIA_DIARIA_CLAVE (16 caracteres o mas) no hace ni manda
# nada. La clave NO va en el correo: se guarda aparte.
COPIA_DIARIA_ACTIVA=false
COPIA_DIARIA_CLAVE=
# Separados por comas.
COPIA_DIARIA_PARA=
# COPIA_DIARIA_HORA=03:30
# COPIA_DIARIA_ZONA=Europe/Madrid
# COPIA_DIARIA_CARPETA=
# COPIA_DIARIA_GUARDAR=7
# Hasta 15. Brevo admite 20 MB por correo contando el adjunto en base64 (+33 %).
# COPIA_DIARIA_MAX_ADJUNTO_MB=10
# COPIA_DIARIA_ENLACE_HORAS=48
# COPIA_DIARIA_PG_DUMP=pg_dump
# La API vista desde fuera, para el enlace. Sin ella: API_PUBLIC_BASE_URL o
# CRM_BASE_URL + /api.
# COPIA_DIARIA_URL_PUBLICA=

# Informe mensual y facturas a la gestoria (#772). El dia INFORME_MENSUAL_DIA,
# desde INFORME_MENSUAL_HORA (Madrid), sale el del mes anterior: un correo por
# empresa con un ZIP (PDF de las facturas emitidas, rectificativas aparte, el
# listado y el informe de ventas por equipo y comercial en Excel). Si el ZIP pasa
# de INFORME_MENSUAL_MAX_ADJUNTO_MB va un enlace firmado que caduca a las
# INFORME_MENSUAL_ENLACE_HORAS. Lo cobrado: suma de pagos con fecha en el mes.
# Apagado de serie: el informe y el ZIP se bajan igual desde Reportes, pero no se
# manda nada. Las direcciones van aqui, nunca en el codigo.
# INFORME_MENSUAL_ACTIVO=false
# La gestoria, por comas. Vale para las empresas que no tengan la suya:
# INFORME_MENSUAL_PARA=
# La de una empresa, por su serie de facturacion o su id (INFORME_MENSUAL_PARA_3):
# INFORME_MENSUAL_PARA_CEDIA=
# Administracion: recibe el de todas.
# INFORME_MENSUAL_ADMINISTRACION=
# Solo estas empresas (series o ids, por comas). Vacio: las que tengan movimiento.
# INFORME_MENSUAL_EMPRESAS=
# INFORME_MENSUAL_DIA=1
# INFORME_MENSUAL_HORA=09:00
# INFORME_MENSUAL_MAX_ADJUNTO_MB=10
# INFORME_MENSUAL_ENLACE_HORAS=168

# Ventas a plazos: la suscripcion de Stripe se cierra sola al completar el pago (#747).
# Cuando lo cobrado de una venta llega a su total, el CRM cancela su suscripcion en
# Stripe y avisa a admision del campus (Matriculas -> Webhooks) y a SUSCRIPCION_AVISO_PARA.
# Apagado, la suscripcion se apunta en la venta y lo que se haria queda en el registro.
# Para cancelar hace falta una clave de Stripe que pueda escribir (la de los links de
# pago o una secreta); con una restringida de solo lectura sale el aviso de «cancelala a mano».
SUSCRIPCION_CIERRE_ACTIVO=false
# Ademas de admision del campus (coma entre direcciones). Ej.: el correo de Manuel.
SUSCRIPCION_AVISO_PARA=
# SUSCRIPCIONES_PLAZOS_DISABLED=1 apaga tambien la revision cada 3 horas.

# Disputas de Stripe (#396): Finanzas -> Disputas. El sondeo va APAGADO de serie: solo
# arranca con STRIPE_DISPUTAS_ACTIVO=1 (lo enciende Diego). Encendido, cada 30 min se leen (solo lectura)
# las disputas de cada cuenta de Stripe conectada y se avisa en la campana a los admins
# de la empresa del campus y a los super admin: al entrar una y otra vez si quedan
# DISPUTAS_AVISO_DIAS dias o menos y sigue sin respuesta en Stripe.
# El CORREO de esos avisos va APAGADO: el CRM lo arma y lo anota en el log, pero no
# llama a Brevo. Lo enciende Diego cuando lo decida (true o 1).
DISPUTAS_CORREO_ACTIVO=false
# DISPUTAS_AVISO_DIAS=3
# Cuantos dias hacia atras se piden a Stripe en cada vuelta (las abiertas mas viejas
# se revisan una a una igualmente).
# DISPUTAS_VENTANA_DIAS=120
# STRIPE_DISPUTAS_TICK_MS=1800000
STRIPE_DISPUTAS_ACTIVO=false
# STRIPE_DISPUTAS_DISABLED=1 lo apaga aunque este encendido (el webhook sigue guardandolas;
# el boton «Sincronizar» de la pantalla tambien funciona con el sondeo apagado).

# --- Meta Ads (#362) ---
# Cada cuantas horas se vuelve a pedir a Meta el gasto de toda la vida de conjuntos y
# anuncios (insights con date_preset=maximum, 2 llamadas por cuenta). El backfill lo pide siempre.
# META_GASTO_TOTAL_CADA_HORAS=12

# --- Stripe: cada pago a su venta, reglas nuevas (puerta 6, CRM#806) ---
# APAGADO DE SERIE. Sin =true un cargo se asocia como siempre: por el correo, a la
# ficha mas nueva del campus, solo si esta «convertida» y tiene venta. Encendido,
# ademas: la venta manda aunque la ficha no este «convertida», se mira en las fichas
# duplicadas, una compra de la web va a la venta de SU formacion y una renovacion va
# a la venta de su suscripcion. Cambia a que venta va el dinero en todos los campus
# y lo que hace «Sincronizar» con los pendientes: lo enciende Diego.
STRIPE_ASOCIACION_V2_ACTIVA=false

# --- Compras directas en la web: crean su venta (puerta 6, CRM#806) ---
# Necesita STRIPE_ASOCIACION_V2_ACTIVA=true ademas de su propio interruptor.
# Un cobro de Stripe de un pedido de WooCommerce que, pasada la espera, sigue sin
# venta (ni por el correo ni por la suscripcion) crea su venta sin gestora, con la
# formacion del pedido. Sin formacion clara, o con un cobro igual ya apuntado en el
# campus, no se crea nada. Apagado por defecto: lo enciende Diego.
COMPRA_DIRECTA_ACTIVA=false
# Horas que se espera antes de crearla, por si la asesora la registra a mano.
COMPRA_DIRECTA_ESPERA_HORAS=24
# Solo cobros de los ultimos N dias: encenderlo no crea las ventas de todo el historico.
COMPRA_DIRECTA_DIAS=30

# ── Registro automático de cobros (#766, migraciones 285 y 286) ────────────
# APAGADOS DE SERIE, también en local y en /testeo. Sin el =1 no se monta el
# sondeo, el webhook contesta 404, no se acepta la integración «paypal» y no se
# pueden subir extractos. Con el =1 y sin credenciales, tampoco pasa nada.
#
# PayPal: la aplicación REST de la cuenta Business de cada campus (client id y
# secreto) se guarda en Integraciones, cifrada. El webhook, opcional, va a
# /api/paypal-webhook/<id del campus> y se comprueba preguntándole a PayPal.
# PAYPAL_COBROS_ACTIVO=1
# Cada cuánto se sondea PayPal (ms). Por defecto, 30 minutos.
# PAYPAL_SYNC_TICK_MS=1800000
#
# Banco (Santander): subir extractos en Norma 43 o CSV desde Finanzas y decidir
# los abonos dudosos en su bandeja.
# SANTANDER_EXTRACTOS_ACTIVO=1

# Auditoria de facturacion cada 2 horas (#765). Mira tres cosas por serie:
# numeros repetidos, facturas emitidas sin los datos fiscales obligatorios y
# cobros con mas de FACTURACION_AUDITORIA_DIAS dias sin factura. Si algo falla,
# PAUSA la emision de facturas nuevas (tambien la manual), avisa por correo a
# superadmin/admin y a FACTURACION_AUDITORIA_CORREOS, y deja un aviso fijo en el
# CRM. No corrige nada. «Marcar como solucionado» vuelve a auditar y solo reanuda
# si sale limpia; entonces emite, en orden de cobro, los cobros que entraron
# durante la pausa. Necesita la migracion 283.
# Apagada de serie: apagada, el CRM factura exactamente como hasta ahora.
# FACTURACION_AUDITORIA_ACTIVA=false
# Dias que puede estar un cobro sin factura (7 del formulario + 2 de margen).
# FACTURACION_AUDITORIA_DIAS=9
# Desde que fecha se audita (AAAA-MM-DD). Sin ella, desde el dia de la primera
# vuelta: el historico no pausa la facturacion el primer dia.
# FACTURACION_AUDITORIA_DESDE=
# A quien mas avisar, separados por comas.
# FACTURACION_AUDITORIA_CORREOS=

# ── Control de subidas por curso (#771, migración 297) ──────────────────────
# La lista de cada curso entregado (vídeos en YouTube, módulos en Moodle, datos
# de directores para la web). Días desde que se abre hasta la fecha límite de
# cada punto (se puede mover punto a punto en la ficha). Por defecto, 7.
# CONTROL_SUBIDAS_PLAZO_DIAS=7
# Aviso en la campana, a quien lleva las subidas del campus, cuando un punto
# pasa su fecha límite. Nunca por correo. APAGADO DE SERIE: =1 lo enciende.
# CONTROL_SUBIDAS_AVISOS=1

# ── Monitask (#236) ─────────────────────────────────────────────────────────
# Qué hace cada colaborador (horas, % de actividad, proyectos y tareas por día)
# y el cotejo con las horas de sus facturas. APAGADO de serie en todas partes:
# sin =1, /api/monitask contesta 404 (también la vuelta del OAuth), no hay
# sincronización nocturna ni tarjeta en Integraciones. Con =1 sale además
# «Equipo › Actividad» en el menú, también en /crm (lo lee de /auth/me), tras
# reiniciar la API y sin recompilar el frontal.
# El Client ID y el Client Secret de la aplicación OAuth de Monitask NO van aquí:
# se pegan en Integraciones (el secreto y los tokens, cifrados con ENCRYPTION_KEY).
# MONITASK_ACTIVO=1
# La «Redirect Uri» de la aplicación de Monitask. Sin ella: CRM_BASE_URL +
# /api/monitask/oauth/callback (la pantalla la enseña para copiarla).
# MONITASK_REDIRECT_URI=https://360crm.tech/crm/api/monitask/oauth/callback
# Días que trae la vuelta de cada noche (hoy incluido). Por defecto, 3.
# MONITASK_SYNC_DIAS=3
# Hora de Madrid desde la que corre la vuelta nocturna. Por defecto, las 3.
# MONITASK_HORA=3
# Zona de los días. Por defecto, Europe/Madrid.
# MONITASK_ZONA=Europe/Madrid
# Solo si Monitask cambia la dirección de su API (solo se acepta *.monitask.com).
# MONITASK_API_URL=https://external.monitask.com
# Los permisos que se piden al conectar. Por defecto, «ExternalApi offline_access».
# MONITASK_SCOPES=ExternalApi offline_access

# --- Renovación de tokens de Meta e Instagram (#471) ---
# Una vez al día renueva los tokens de larga duración (60 días) de las cuentas de
# Meta Ads de cada campus (fb_exchange_token) y de las de Instagram (ig_refresh_token)
# antes de que caduquen, y avisa a los admins (campana y correo) si falla o si un
# token caduca en menos de META_TOKENS_AVISO_DIAS. APAGADO de serie: sin =1 no arranca
# y no se llama a Meta.
# META_TOKENS_RENOVACION_ACTIVA=1
# La app de Meta de la que salen los tokens (para leer su caducidad y renovar los de
# Meta Ads). Sin ellas se usan IG_APP_ID / IG_APP_SECRET.
# META_APP_ID=
# META_APP_SECRET=
# IG_GRAPH_VERSION=v25.0
# Se renueva cuando faltan menos de estos días (60 - 40 = tokens con más de 20 días).
# META_TOKENS_RENOVAR_DIAS=40
# META_TOKENS_AVISO_DIAS=7

# --- Google Analytics 4 (CRM#55) ---
# Cada 6 h trae de GA4 sesiones por canal y por página de entrada de cada campus
# con credencial «google_analytics» (se guarda cifrada en Configuración › Claves:
# el JSON de la cuenta de servicio de Google con "property_id" añadido; la cuenta
# tiene que ser «Lector» de la propiedad). APAGADO de serie.
# Desde CRM#1210 se enciende POR CAMPUS en Integraciones › Google Analytics 4
# («Sincronizar este campus»). Esta variable es solo la RESERVA: vale para los
# campus en los que nadie ha tocado el interruptor. La tarjeta dice de dónde sale.
# GA4_SYNC_ACTIVO=1
# GA4_SYNC_TICK_MS=21600000

# --- Search Console (CRM#36) ---
# Cada 6 h trae de Search Console clics, impresiones y posición (del sitio, por
# página y por búsqueda) de cada campus con credencial «gsc» (Configuración ›
# Claves: el JSON de la cuenta de servicio de Google con "site_url" añadido,
# «sc-domain:web.com» o «https://web.com/»; la cuenta tiene que ser usuaria de
# la propiedad). Una vez al día mira además si las páginas de formación están
# indexadas. APAGADO de serie. Como en GA4 (CRM#1210): se enciende por campus en
# Integraciones › Search Console y esta variable es solo la reserva.
# GSC_SYNC_ACTIVO=1
# GSC_SYNC_TICK_MS=21600000
# Los lunes, aviso en la campana a los admin del campus si la última semana cae
# más de este % contra la anterior (CRM#1156). 0 apaga esa métrica. Los mínimos
# son de la semana anterior: por debajo no se avisa (de 5 clics a 3 no es nada).
# Desde CRM#1210 se ponen por campus en la tarjeta de Search Console; estas
# variables son la reserva para los campus que no los han cambiado.
# GSC_AVISO_CAIDA_CLICS=30
# GSC_AVISO_CAIDA_IMPRESIONES=30
# GSC_AVISO_MIN_CLICS=20
# GSC_AVISO_MIN_IMPRESIONES=200

# Roles del curso de Moodle que cuentan como tutora, además de Profesor (editingteacher)
# y Profesor sin edición (teacher). ISEIE: las redactoras están como Gestor → manager.
# MOODLE_ROLES_TUTORA=manager
