# Database
DATABASE_URL=postgresql://crm_user:password@localhost:5432/crm_db

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Encryption (AES-256-GCM para API keys)
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-access-key
CLOUDFLARE_R2_SECRET_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET=crm-dossiers

# Brevo (email)
BREVO_API_KEY=your-brevo-api-key

# DE QUIEN SALEN LOS CORREOS DEL CRM.
#
# Si esto se queda vacio, el codigo cae en `no-reply@crm-test.local`, que es un
# dominio QUE NO EXISTE. Los correos saldrian —Brevo los acepta si el remitente
# esta dado de alta— y nadie podria contestarlos ni saber de donde vienen.
#
# El remitente tiene que estar VERIFICADO EN BREVO, no basta con que el buzon
# exista: Brevo manda en su nombre, y sin verificar rechaza el envio. Se da de
# alta en Remitentes y se confirma pulsando el enlace que llega a ese buzon.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# «Avisar tutor»: el correo mensual de comisiones sale de una direccion distinta
# —la de facturacion— porque le pide al tutor que CONTESTE con su factura, y esa
# respuesta tiene que caer donde alguien la lee.
#
# Si se deja vacio usa `facturacion@cediaidsl.com`, que es la cuenta de la casa.
# Vale lo mismo que arriba: verificada en Brevo o no sale.
AVISO_TUTOR_FROM=
AVISO_TUTOR_FROM_NAME=

# LA COPIA EN «ENVIADOS» DEL BUZON DE VERDAD.
#
# Brevo manda EN NOMBRE de la direccion, no DESDE ella: el correo no pasa por
# Hostinger y su carpeta de enviados no se entera. Para quien recibe es un
# correo normal; para quien lo manda, es como si no hubiera existido.
#
# Con esto puesto, el CRM deja una copia por IMAP despues de mandar — que es lo
# que hace un cliente de correo por debajo. Ojo: SMTP tampoco guarda en
# Enviados; quien guarda es el cliente, con el comando APPEND.
#
# Vacio = no se guarda copia y todo lo demas funciona igual.
#
# QUE SE PONE AQUI, sin rodeos:
#
#   IMAP_USER      el buzon de facturacion de CEDIA, que es el mismo del que
#                  salen los avisos al tutor (ver AVISO_TUTOR_FROM, arriba).
#   IMAP_PASSWORD  la contrasena de ESE buzon. La de siempre, la que se usa para
#                  entrar al webmail de Hostinger.
#
# Ojo, que son dos contrasenas distintas y se confunden: NO es la del panel de
# Hostinger (la de la cuenta), es la del buzon. Si hiciera falta cambiarla:
# hPanel -> Correos -> la cuenta -> Cambiar contrasena.
#
# LA CONTRASENA NO SE ESCRIBE NI AQUI NI EN NINGUN SITIO DEL REPOSITORIO. Este
# fichero es el ejemplo y va en git: se rellena en el `.env` del servidor, que
# no se sube.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=facturacion@cediaidsl.com
IMAP_PASSWORD=

# LA SALIDA POR EL BUZON PROPIO, para que no caiga en Promociones.
#
# Brevo engancha a todo lo que sale por ahi las cabeceras de una lista de
# correo: `List-Unsubscribe`, `List-Unsubscribe-Post`, `X-CSA-Complaints` y
# `Feedback-ID: ...Sendinblue`. Gmail las lee y archiva el correo en la pestaña
# de Promociones. No se quitan desde el mensaje —se intento pisarlas por el
# parametro `headers` de la API y Brevo las vuelve a poner—: es ajuste de
# cuenta.
#
# Saliendo por el SMTP del propio buzon no aparece ninguna, y el correo sigue
# firmado por el dominio. Para los avisos al tutor —pocos, personales, con su
# factura y pidiendo respuesta— es ademas el tubo que les corresponde.
#
# SOLO se usa para los correos que salen DESDE esta direccion. Lo demas —avisos
# de lead, bienvenidas, lo que va en volumen— sigue por Brevo. Y si el buzon
# falla, el correo cae hacia Brevo igualmente: llegar a Promociones es un
# fastidio, no llegar es un problema.
#
# Es LA MISMA CUENTA de arriba —el buzon de facturacion de CEDIA— y por eso
# estos cuatro se pueden dejar vacios: si no estan, se usan los IMAP_*. Solo hay
# que rellenarlos el dia que la salida y la lectura dejen de ser el mismo buzon.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# EL CORREO QUE ENTRA (#146).
#
# Con las credenciales de arriba puestas, el CRM lee el buzon cada media hora y
# guarda lo que ha llegado: las respuestas de los tutores con su factura, que
# hasta ahora se quedaban fuera del CRM aunque la conversacion la empezara el.
#
# Lo abre en SOLO LECTURA: no marca como leido, no borra y no mueve nada. Quien
# tenga el webmail abierto no nota que el CRM ha pasado por ahi.
#
# No hace falta configurar nada mas: usa las credenciales de arriba —el buzon de
# facturacion de CEDIA y su contrasena—. Estas dos solo estan para apagarlo o
# cambiarle el ritmo.
CORREO_ENTRANTE_TICK_MS=1800000
# CORREO_ENTRANTE_DISABLED=1

# El freno: fuera de produccion no sale ni un correo a un cliente real.
#
# Direcciones separadas por comas. Admite dominios enteros con @:
#   EMAIL_LISTA_BLANCA=admin@empresa.com,pruebas@gmail.com
#
# En produccion (NODE_ENV=production) esta variable NO se mira y sale todo.
# Fuera de produccion, si esta vacia NO SALE NINGUN CORREO — a proposito: quien
# monte un entorno y se olvide de ponerla se queda sin correos, que es un
# problema visible y sin consecuencias. Dejar pasar todo por defecto seria un
# problema invisible que se come un cliente.
#
# Basta con que UN destinatario no este en la lista para no mandar el correo a
# nadie: los avisos a administradores van a varias direcciones a la vez.
EMAIL_LISTA_BLANCA=

# Aviso «prospecto sin contactar» (tarea #28).
# A los cuantos minutos avisar a su gestora, y cada cuanto se comprueba.
LEAD_SIN_TOCAR_MINUTOS=30
LEAD_SIN_TOCAR_TICK_MS=300000
# Para apagarlo del todo en un entorno:
# LEAD_SIN_TOCAR_DISABLED=1

# Google OAuth (compartido para todos los proyectos — F2-014)
# Obtener en https://console.cloud.google.com → APIs & Services → Credentials.
# El refresh_token de cada cuenta se guarda en api_credentials.encrypted_value
# (service='google_ads'). El cron googleAdsTokenScheduler valida diariamente.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Opcional: deshabilita el cron de validacion (1=off, vacio=on)
# GOOGLE_TOKEN_DISABLED=
# Intervalo de cron en ms (default 24h)
# GOOGLE_TOKEN_TICK_MS=86400000

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=info
# ── WhatsApp ─────────────────────────────────────────────────────────────────
#
# El CRM habla con un servicio que expone los endpoints de Evolution API. En los
# dos servidores hay Evolution en Docker; en local se puede usar un puente con
# Baileys que imita esos mismos endpoints, porque Docker no arranca en todas las
# maquinas. El CRM no distingue cual de los dos hay detras.
#
# Sin EVOLUTION_URL y EVOLUTION_API_KEY el modulo se queda inerte y lo avisa —no
# rompe nada—, porque comprueba si esta configurado antes de llamar.

# Donde escucha. Escucha SOLO en 127.0.0.1: no se expone al exterior.
#   MultiCRM: http://127.0.0.1:8080
#   ISEIE:    http://127.0.0.1:8081   (el 8080 lo ocupa Nginx)
EVOLUTION_URL=http://127.0.0.1:8080

# La clave que protege Evolution. NO se pide a nadie: te la inventas y la pones
# igual en los dos sitios — aqui y en AUTHENTICATION_API_KEY del compose.
#   openssl rand -hex 32
EVOLUTION_API_KEY=

# Prefijo de las sesiones. Cada usuario tiene la suya: crm-u7, crm-u12...
# El id del usuario va dentro del nombre, y de ahi sale el aislamiento.
#
# CAMBIALO EN CADA ENTORNO. Si pruebas y produccion comparten prefijo, comparten
# sesiones: alguien probando en /testeo DESCONECTA el WhatsApp de una gestora
# que esta trabajando. En produccion «crm», en pruebas «testeo».
EVOLUTION_INSTANCIA=crm

# A DONDE AVISA EVOLUTION cuando entra un mensaje de una sesion de este entorno.
#
# Vacio = se usa el webhook global del contenedor, que apunta a un solo sitio; y
# entonces los mensajes de pruebas acaban en la base de produccion. Ponla siempre
# que haya mas de un entorno contra el mismo Evolution.
#   http://172.17.0.1:3002/api/whatsapp/webhook?s=EL_MISMO_SECRETO
EVOLUTION_WEBHOOK_URL=

# OBLIGATORIO en produccion: sin el, el webhook responde 503 y no procesa nada.
#
# Esa ruta va ANTES del verifyToken —la llama el contenedor, no un navegador—,
# asi que dejarlo vacio permitiria a cualquiera que supiera la direccion meter
# mensajes inventados en la conversacion de una gestora.
#
# Se acepta en la cabecera x-webhook-secret o dentro de la propia direccion: el
# webhook GLOBAL de Evolution no deja mandar cabeceras propias, y con el secreto
# solo por cabecera habria rechazado TODOS los mensajes entrantes.
#   openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=

# ¿Entran los grupos de WhatsApp? 'si' (por defecto) o 'no'.
#
# Esto vivia como `groupsIgnore: true` en la llamada a Evolution y NO se
# cumplia: en la base de pruebas habia 2 grupos de 5 conversaciones, con
# mensajes del mismo dia. Tres motivos a la vez — el puente de Baileys no
# implementa el flag, `guardarAjustes` lo apagaba al tocar el interruptor de
# llamadas, y el propio CRM aceptaba grupos a proposito.
#
# El valor por defecto es 'si' porque es lo que YA pasa hoy en los dos entornos;
# ponerlo en 'no' habria sido colar un cambio de comportamiento dentro de un
# arreglo. Con 'no' los grupos dejan de entrar DE VERDAD —lo aplica el CRM, no
# el proveedor— y tampoco se ensenan los que ya estuvieran guardados.
#
# A favor de 'no': este numero es para escribir a prospectos y cada interaccion
# rara suma para que WhatsApp lo suspenda. A favor de 'si': hay grupos de
# trabajo que las gestoras usan, y es lo que pide la tarea #74.
WHATSAPP_GRUPOS=si

# Los frenos que protegen el numero. Lo que hace que WhatsApp suspenda una linea
# no es tanto detectar el cliente como que la gente la bloquee y la reporte, asi
# que estos numeros son conservadores a proposito. Son POR NUMERO.
WA_TOPE_MINUTO=6
WA_TOPE_HORA=60
WA_TOPE_DIA=300
WA_PAUSA_MS=1500

# Cuantos dias de historial de adjuntos se bajan solos al enlazar. Lo de ahora se
# baja siempre y con prioridad; lo mas viejo sale como «Descargar» en el chat.
# Sin tope, un movil de anos mete 17.000 archivos en la cola y lo que envias se
# pone detras de todos.
WA_MEDIA_DIAS=30

# Donde se guardan los adjuntos ya descargados.
UPLOADS_DIR=/var/crm-uploads

# El freno de escribir a desconocidos. VIENE APAGADO — decision de Diego,
# 21/08/2026.
#
# Impedia el primer mensaje a un numero que no fuera prospecto y que nunca
# hubiera escrito. No evitaba nada: la gestora escribia igual desde su movil,
# pero sin registro, sin plantilla y sin los topes de ritmo de arriba.
#
# Escribir a quien no pidio informacion sigue siendo lo que hace que reporten un
# numero, asi que queda apuntado en el registro. El freno ahora es saberlo, no
# impedirlo. Para volver a frenar, true — pero eso se habla antes con Diego.
#
# La variable vieja se llamaba WA_EXIGIR_CONSENTIMIENTO y significaba lo
# CONTRARIO. Si sigue en algun .env, el servidor la ignora y lo avisa al
# arrancar; quitala.
WA_BLOQUEO_DESCONOCIDOS=false


# Volcado de la FORMA de los avisos de WhatsApp. Apagado salvo para diagnosticar.
#
# Con esto a 1, el CRM apunta la ESTRUCTURA de los primeros avisos de cada tipo
# que manda Evolution: que claves vienen, de que tipo, y si `data` llega como
# objeto o como lista. NO guarda textos, telefonos ni nombres — solo la forma,
# que es lo que hace falta para saber donde mirar.
#
# Se lee en GET /api/whatsapp/forma-avisos (soporte o superadmin) y se puede
# pegar en un issue sin pensarlo. Vive en memoria: se va al reiniciar.
WHATSAPP_VOLCAR_FORMA=0
